{
  "name": "Preference",
  "type": "object",
  "description": "Preferencias del usuario para el Digest personalizado. Un usuario tiene como máximo una configuración activa. Los defaults permiten funcionar sin configuración previa.",
  "properties": {
    "preferred_categories": { "type": "array", "items": { "type": "string" }, "description": "Categorías que el usuario quiere priorizar en su Digest" },
    "preferred_languages": { "type": "array", "items": { "type": "string" }, "description": "Idiomas preferidos (es, en, fr, ...)" },
    "keywords": { "type": "array", "items": { "type": "string" }, "description": "Temas de interés del usuario (texto libre)" },
    "followed_entities": { "type": "array", "items": { "type": "string" }, "default": [], "description": "Entidades seguidas (nombres normalizados, matching exacto case-insensitive)" },
    "followed_countries": { "type": "array", "items": { "type": "string" }, "default": [], "description": "Países seguidos (códigos ISO)" },
    "primary_country": { "type": "string", "default": "ES", "description": "País principal del usuario (código ISO). Sus historias se priorizan en el Digest sin excluir al resto del mundo. Por defecto España (ES)." },
    "excluded_categories": { "type": "array", "items": { "type": "string" }, "default": [], "description": "Categorías excluidas del Digest (filtro duro)" },
    "excluded_entities": { "type": "array", "items": { "type": "string" }, "default": [], "description": "Entidades excluidas del Digest (filtro duro, matching exacto case-insensitive)" },
    "minimum_score": { "type": "number", "default": 0, "description": "RENIVYA SCORE mínimo para incluir una Story en el Digest" },
    "minimum_confidence": { "type": "number", "default": 0, "description": "Confidence mínima para incluir una Story en el Digest" },
    "digest_size": { "type": "number", "default": 10, "description": "Número máximo de Stories en el Digest" },
    "digest_frequency": { "type": "string", "default": "daily", "description": "Frecuencia del Digest (daily, weekly, realtime)" },
    "world_mode_enabled": { "type": "boolean", "default": true, "description": "Modo WORLD: importancia global, sin personalización" },
    "daily_briefing_time": { "type": "string", "description": "Hora del briefing diario (HH:mm)" },
    "weekly_summary_enabled": { "type": "boolean", "default": true },
    "alert_threshold": { "type": "number", "default": 80, "description": "Umbral de RENIVYA SCORE para alertas" },
    "updated_at": { "type": "string", "format": "date-time", "description": "Última actualización de preferencias" }
  },
  "required": [],
  "rls": {
    "read": { "created_by_id": "{{user.id}}" },
    "update": { "created_by_id": "{{user.id}}" },
    "delete": { "created_by_id": "{{user.id}}" }
  }
}
