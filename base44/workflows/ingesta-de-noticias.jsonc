{
  // Workflow programado "Ingesta de noticias".
  // Cada 30 minutos: FetchNewsFeeds (feeds RSS activos → pipeline completo → mantenimiento).
  // Autorización: cabecera x-cron-secret = variable de entorno CRON_SECRET (o ejecución como admin).
  "name": "Ingesta de noticias",
  "schedule": { "cron": "*/30 * * * *", "timezone": "Europe/Madrid" },
  "steps": [
    { "function": "FetchNewsFeeds", "payload": { "maxSources": 30 } },
    { "function": "EmbedArticles", "payload": { "limit": 200 }, "continue_on_error": true }
  ]
}
